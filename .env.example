# Copy this file to `.env` and fill in real values for local development.
# `.env` is git-ignored — never commit real credentials.
#
# Two different consumers read this one file:
#   1. Expo/Metro — only EXPO_PUBLIC_* vars, inlined into the JS bundle at
#      build time (visible to anyone who can inspect the client).
#   2. The Supabase CLI (`npm run supabase:start`) — the auth.external.*
#      `env(...)` references in supabase/config.toml, read from the shell
#      environment when the local stack starts.
# Never put a secret behind an EXPO_PUBLIC_* name — see docs/DECISIONS.md.

# ---------------------------------------------------------------------------
# Mobile app (EXPO_PUBLIC_*) — safe to ship to a device
# ---------------------------------------------------------------------------

# Local Supabase API URL. `supabase start` prints this; for the default
# local stack it's http://127.0.0.1:54321. Use your machine's LAN IP
# instead of 127.0.0.1 when testing on a physical device/simulator that
# can't reach localhost directly.
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon (public) API key — `supabase start` prints this too. Never
# the service_role key; that key must never reach the mobile app.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Free-form label shown in the Profile screen and structured logs so it's
# obvious which backend a build is talking to (e.g. "local", "staging").
EXPO_PUBLIC_APP_ENV=local

# Show the Google / Apple sign-in buttons. Flip to "true" only once the
# matching supabase/config.toml auth.external.* block is actually enabled
# with real credentials (see docs/DECISIONS.md) — the buttons stay hidden
# otherwise, per docs/SECURITY_AND_PRIVACY.md's "no fake working behavior".
EXPO_PUBLIC_AUTH_GOOGLE_ENABLED=false
EXPO_PUBLIC_AUTH_APPLE_ENABLED=false

# ---------------------------------------------------------------------------
# Local Supabase stack — server-side OAuth provider credentials
# ---------------------------------------------------------------------------
# Only needed if you're testing Google/Apple sign-in locally (see
# docs/DECISIONS.md, "Google and Apple Auth", for the exact provider-console
# setup each requires). Leave blank to leave those providers disabled —
# email/password auth works without any of these.

SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
