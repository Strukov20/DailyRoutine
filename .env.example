# Copy this file to `.env` and fill in real values for local development.
# `.env` is git-ignored — never commit real credentials.
#
# Variables prefixed with EXPO_PUBLIC_ are inlined into the JS bundle by
# Metro and are therefore visible to anyone who can inspect the client.
# Only put values here that are safe to ship to a device (the Supabase
# anon key is designed for this; never put a service-role key here).

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon (public) API key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Free-form label shown in the Profile screen and structured logs so it's
# obvious which backend a build is talking to (e.g. "local", "staging").
EXPO_PUBLIC_APP_ENV=local
